# ===== Умный распорядок: настройки сервера =====
# Скопируй файл:  cp .env.example .env  — и заполни.

# Домен приложения (нужен для HTTPS: без него iPhone не установит приложение и не даст уведомления)
DOMAIN=raspisanie.duckdns.org
PUBLIC_URL=https://raspisanie.duckdns.org

# Пароль для входа в приложение — придумай длинный
APP_PASSWORD=

# Группа ТулГУ и как часто проверять расписание (минуты)
TULSU_GROUP=720043-03
TULSU_POLL_MIN=30

# ----- Нейросеть -----
# yandex — YandexGPT (Yandex AI Studio), openai — любой OpenAI-совместимый API, mock — тестовый режим без ИИ
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Умная модель — для плана недели и чата; быстрая — для подсчёта еды и оценки задач
AI_MODEL=yandexgpt/latest
AI_MODEL_FAST=yandexgpt-lite/latest

# Пример для OpenAI-совместимого провайдера (например, DeepSeek):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# AI_MODEL=deepseek-chat
# AI_MODEL_FAST=deepseek-chat

# Контакт для push-уведомлений (требование стандарта Web Push), можно любой свой e-mail
VAPID_SUBJECT=mailto:me@example.com

# Часовой пояс в минутах от UTC (Тула/Москва = 180)
TZ_OFFSET_MIN=180
